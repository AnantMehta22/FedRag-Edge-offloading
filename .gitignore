# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Vector Database runtime files (auto-generated during indexing)
chroma_db/
*.sqlite3

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE and Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
tmp/
temp/

# PyTorch / ML checkpoints (if saved locally)
*.pt
*.pth
*.bin
!outputs/*.png
